{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "useUnknownInCatchVariables": true,
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
