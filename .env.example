DEBUG=false
PORT=3000

# Set when behind a reverse proxy so per-IP rate limits (login and app pairing) see the real client address; e.g. TRUST_PROXY=1
# Values: true/false, number of proxy hops, or a subnet list like "loopback, 10.0.0.0/8"
# TRUST_PROXY=
# Behind Cloudflare Tunnel + Traefik (k3s): TRUST_PROXY=1 and CLIENT_IP_HEADER=cf-connecting-ip (the header with the real
# client address, copied into X-Forwarded-For). Only set it when every request comes through that proxy.
# CLIENT_IP_HEADER=

# Auth config
JWT_SECRET=
# Passkeys (WebAuthn). RP id = the site's host name without scheme/port (localhost in dev). Origins: every URL the
# web app is opened on, comma separated (e.g. https://jotihunt.example,http://localhost:5173).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# WEBAUTHN_RP_NAME=Jotihunt Tracker
# Base URL of the web app, used in invite and herstel links (e.g. https://jotihunt.example)
PUBLIC_APP_URL=

# Database config
MONGO_URI=

# Traccar config
TRACCAR_API_URL=
TRACCAR_API_TOKEN=
# Address the Traccar Client app sends positions to (OsmAnd port 5055), used in the onboarding QR code
TRACCAR_CLIENT_URL=

# Jotihunt config
JOTIHUNT_API_URL=https://jotihunt.nl/api/2.0
JOTIHUNT_WEB_URL=https://jotihunt.nl

# Groups may set their own deelgebied on the map (shared with the client); admins can always
TEAMS_AREA_EDITING=false

# Server time zone: sticker times and hunt deadlines are read in local time
TZ=Europe/Amsterdam

# Where hunt photos are stored (default ./uploads)
UPLOADS_DIR=
# Where the Android app APK and latest.json live (default ./app-releases); served at /app/latest and /app/download/<file>
APP_DIR=

# Walking times for the fox prediction (OpenRouteService). Optional: without a key straight-line estimates are used.
ORS_API_KEY=

# Encrypts keys and passwords saved in Beheer (Gemini key, Jotihunt login, Telegram app hash).
# Generate with: openssl rand -base64 32
# Team, hunt times, vehicle groups, Gemini key/models, Jotihunt login and Telegram app details are set in Beheer.
# The old env vars (GEMINI_API_KEY, GROUP_NAME, …) still work as a fallback when Beheer has no value.
SETTINGS_KEY=

# NS Reisinformatie API (apiportal.ns.nl) for the Intel chat OV tools: train stations, departures and journeys.
# Optional: without a key the OV tools only use OVapi (bus/tram/metro/boat, no key needed).
NS_API_KEY=

# Web Push (pushmeldingen). Generate once with: npx web-push generate-vapid-keys
# Optional: without keys there are no push notifications; in-app sounds and toasts still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Telegram: reads the messages of @Jotihunt_bot to the group's Telegram account (an admin links it by QR code in the
# "Jotihunt-berichten" card) and alerts everyone on a tegenhunt. Optional: without API id/hash the feature is off.
# Encrypts the stored Telegram session (AES-256-GCM): 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it means an admin has to link Telegram again.
TELEGRAM_SESSION_KEY=
# Life360: team members without our app share their location through a Life360 circle (an admin links a separate
# Life360 account by e-mail code in the "Life360" card). Optional: without the key the Life360 layer is off.
# Encrypts the stored Life360 token (AES-256-GCM): 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it means an admin has to log in to Life360 again.
LIFE360_SESSION_KEY=
# Encrypts the stored Jotiboard session (AES-256-GCM): 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it means an admin has to log in to Jotiboard again.
JOTIBOARD_SESSION_KEY=

# Sentry error reporting (sentry.io). Optional: without SENTRY_DSN nothing is sent.
# Errors only: no tracing, no request bodies, no AI prompts, no IP addresses; the user is sent as id + name.
SENTRY_DSN=
# Defaults to NODE_ENV
SENTRY_ENVIRONMENT=
# DSN of the website's Sentry project: /sentry-tunnel forwards only envelopes for this project (ad blockers block sentry.io)
SENTRY_SITE_DSN=
# SENTRY_RELEASE is set by the Docker image (git commit)
