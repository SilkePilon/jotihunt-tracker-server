DEBUG=false
PORT=3000

# Set when behind a reverse proxy so per-IP rate limits (login and app pairing) see the real client address; e.g. TRUST_PROXY=1
# Values: true/false, number of proxy hops, or a subnet list like "loopback, 10.0.0.0/8"
# TRUST_PROXY=
# Behind Cloudflare Tunnel + Traefik (k3s): TRUST_PROXY=1 and CLIENT_IP_HEADER=cf-connecting-ip (the header with the real
# client address, copied into X-Forwarded-For). Only set it when every request comes through that proxy.
# CLIENT_IP_HEADER=

# Auth config
JWT_SECRET=

# Database config
MONGO_URI=

# Traccar config
TRACCAR_API_URL=
TRACCAR_API_TOKEN=
# Address the Traccar Client app sends positions to (OsmAnd port 5055), used in the onboarding QR code
TRACCAR_CLIENT_URL=

# Jotihunt config
JOTIHUNT_API_URL=https://jotihunt.nl/api/2.0
JOTIHUNT_WEB_URL=https://jotihunt.nl
JOTIHUNT_WEB_USERNAME=
JOTIHUNT_WEB_PASSWORD=

# Optional: Traccar group ids per vehicle (map icons and the onboarding vehicle picker)
GROUP_WALKING_ID=
GROUP_CAR_ID=
GROUP_MOTORCYCLE_ID=
GROUP_BIKE_ID=

# Groups may set their own deelgebied on the map (shared with the client); admins can always
TEAMS_AREA_EDITING=false

# Server time zone: sticker times and hunt deadlines are read in local time
TZ=Europe/Amsterdam

# Where hunt photos are stored (default ./uploads)
UPLOADS_DIR=
# Where the Android app APK and latest.json live (default ./app-releases); served at /app/latest and /app/download/<file>
APP_DIR=

# Walking times for the fox prediction (OpenRouteService). Optional: without a key straight-line estimates are used.
ORS_API_KEY=

# Google Gemini. Optional: without a key HQ enters hunt code and time by hand, and fox prediction is off.
# Hunt photos, the marker trail and group coordinates are sent to Google; on the free tier Google may use them to improve its products.
# Fox prediction: roughly one GEMINI_PREDICTION_MODEL call per active area per 10 minutes, one at a time.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PREDICTION_MODEL=gemini-pro-latest
# Model for the Gemini assistant on the hints page (optional)
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Web Push (pushmeldingen). Generate once with: npx web-push generate-vapid-keys
# Optional: without keys there are no push notifications; in-app sounds and toasts still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Telegram: reads the messages of @Jotihunt_bot to the group's Telegram account (an admin links it by QR code in the
# "Jotihunt-berichten" card) and alerts everyone on a tegenhunt. Optional: without API id/hash the feature is off.
# API id and hash: create an app once at https://my.telegram.org (API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Encrypts the stored Telegram session (AES-256-GCM): 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it means an admin has to link Telegram again.
TELEGRAM_SESSION_KEY=
# Only messages from this username are handled (default Jotihunt_bot; set to a test bot to try it out)
TELEGRAM_BOT_USERNAME=
