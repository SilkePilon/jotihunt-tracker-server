DEBUG=false
PORT=3000

# Auth config
JWT_SECRET=

# Database config
MONGO_URI=

# Tracarr config
TRACCARR_API_URL=
TRACCARR_API_TOKEN=
# Address the Traccar Client app sends positions to (OsmAnd port 5055), used in the onboarding QR code
TRACCAR_CLIENT_URL=

# Jotihunt config
JOTIHUNT_API_URL=https://jotihunt.nl/api/2.0
JOTIHUNT_WEB_URL=https://jotihunt.nl
JOTIHUNT_WEB_USERNAME=
JOTIHUNT_WEB_PASSWORD=

HUNT_START_DATE=
HUNT_END_DATE=

# Fox prediction (OpenRouteService). Optional: without a key straight-line estimates are used.
ORS_API_KEY=

# Hunt photo OCR (Google Gemini). Optional: without a key HQ enters code and time by hand.
# Photos are sent to Google; on the free tier Google may use them to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PREDICTION_MODEL=gemini-pro-latest
