DEBUG=false
PORT=3000

# Auth config
JWT_SECRET=

# Database config
MONGO_URI=

# Traccar config
TRACCAR_API_URL=
TRACCAR_API_TOKEN=
# Address the Traccar Client app sends positions to (OsmAnd port 5055), used in the onboarding QR code
TRACCAR_CLIENT_URL=

# Jotihunt config
JOTIHUNT_API_URL=https://jotihunt.nl/api/2.0
JOTIHUNT_WEB_URL=https://jotihunt.nl
JOTIHUNT_WEB_USERNAME=
JOTIHUNT_WEB_PASSWORD=

# Optional: Traccar group ids per vehicle (map icons and the onboarding vehicle picker)
GROUP_WALKING_ID=
GROUP_CAR_ID=
GROUP_MOTORCYCLE_ID=
GROUP_BIKE_ID=

# Groups may set their own deelgebied on the map (shared with the client); admins can always
TEAMS_AREA_EDITING=false

# Server time zone: sticker times and hunt deadlines are read in local time
TZ=Europe/Amsterdam

# Where hunt photos are stored (default ./uploads)
UPLOADS_DIR=

# Walking times for the fox prediction (OpenRouteService). Optional: without a key straight-line estimates are used.
ORS_API_KEY=

# Google Gemini. Optional: without a key HQ enters hunt code and time by hand, and fox prediction is off.
# Hunt photos, the marker trail and group coordinates are sent to Google; on the free tier Google may use them to improve its products.
# Fox prediction: roughly one GEMINI_PREDICTION_MODEL call per active area per 10 minutes, one at a time.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PREDICTION_MODEL=gemini-pro-latest

# Web Push (pushmeldingen). Generate once with: npx web-push generate-vapid-keys
# Optional: without keys there are no push notifications; in-app sounds and toasts still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
